name: jncie-sp-vjunos
prefix: ""

topology:
  kinds:
    juniper_vjunosrouter:
      image: vrnetlab/juniper_vjunos-router:25.4R1.12
      cpu: 1.5
      exec:
        - sh -c 'nohup /.venv/bin/python3 -m http.server 81 --bind 0.0.0.0 --directory /labconfigs >/tmp/config-http.log 2>&1 &'
        - sh -c 'HTTP_UPLOAD_USER=admin HTTP_UPLOAD_PASSWORD=admin@123 ARCHIVE_NODE=r1 nohup /.venv/bin/python3 /usr/local/bin/http_receiver.py --bind 0.0.0.0 --port 82 --directory /lab-archive >/tmp/config-receiver.log 2>&1 &'
      binds:
        - ./scripts/http_receiver.py:/usr/local/bin/http_receiver.py:ro
  
  nodes:
    # --- Router Definitions ---
    r1:
      kind: juniper_vjunosrouter
      binds:
        - ./configs/r1:/labconfigs:rw
        - ./config-archive/r1:/lab-archive
    r2:
      kind: juniper_vjunosrouter
      binds:
        - ./configs/r2:/labconfigs:rw
        - ./config-archive/r2:/lab-archive
    r3:
      kind: juniper_vjunosrouter
      binds:
        - ./configs/r3:/labconfigs:rw
        - ./config-archive/r3:/lab-archive
    r4:
      kind: juniper_vjunosrouter
      binds:
        - ./configs/r4:/labconfigs:rw
        - ./config-archive/r4:/lab-archive
    r5:
      kind: juniper_vjunosrouter
      binds:
        - ./configs/r5:/labconfigs:rw
        - ./config-archive/r5:/lab-archive
    r6:
      kind: juniper_vjunosrouter
      binds:
        - ./configs/r6:/labconfigs:rw
        - ./config-archive/r6:/lab-archive


    # note, that the bridge br-univ must be created manually
    # sudo ip link add br-univ type bridge
    # sudo ip link set br-univ up
    br-univ:
      kind: bridge

  links:
    # --- Point-to-Point Links (LAG) R1 <-> R2 ---
    # eth2 = ge-0/0/1   eth3 = ge-0/0/2
    - endpoints: ["r1:eth2", "r2:eth2"]
    - endpoints: ["r1:eth3", "r2:eth3"]

    # --- Point-to-Point Links (LAG) R5 <-> R6 ---
    # eth2 = ge-0/0/1   eth3 = ge-0/0/2
    - endpoints: ["r5:eth2", "r6:eth2"]
    - endpoints: ["r5:eth3", "r6:eth3"]

    # --- Mesh Connections (Semua connect ke Switch s1) ---
    # Menggunakan eth1 yang mapping ke ge-0/0/4
    - endpoints: ["r1:eth1", "br-univ:r1_ge0"]
    - endpoints: ["r2:eth1", "br-univ:r2_ge0"]
    - endpoints: ["r3:eth1", "br-univ:r3_ge0"]
    - endpoints: ["r4:eth1", "br-univ:r4_ge0"]
    - endpoints: ["r5:eth1", "br-univ:r5_ge0"]
    - endpoints: ["r6:eth1", "br-univ:r6_ge0"]
