# LAB-011 baseline R4 — Area 1, service prefix .4/32 on existing lo0.0.
set interfaces eth1 unit 34 vlan-id 34
set interfaces eth1 unit 34 family inet address 10.0.34.2/30
set interfaces eth1 unit 45 vlan-id 45
set interfaces eth1 unit 45 family inet address 10.0.45.1/30
set interfaces lo0 unit 0 family inet address 10.1.1.4/32
set interfaces lo0 unit 0 family inet address 192.168.11.4/32
set routing-options router-id 10.1.1.4
set protocols ospf area 0.0.0.1 interface eth1.34 interface-type p2p
set protocols ospf area 0.0.0.1 interface eth1.45 interface-type p2p
set protocols ospf area 0.0.0.1 interface lo0.0 passive
