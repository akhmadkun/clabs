hostname R2
!
interface Ethernet0/1
 ip ospf cost 5
 ip ospf 1 area 0
 no shutdown
!
interface Ethernet0/2
 ip ospf cost 3
 ip ospf 1 area 0
 no shutdown
!
interface Ethernet0/3
 ip ospf cost 5
 ip ospf 1 area 0
 no shutdown
!
interface Loopback0
 ip address 2.2.2.2 255.255.255.255
 ip ospf 1 area 0
!
router ospf 1
 router-id 2.2.2.2
