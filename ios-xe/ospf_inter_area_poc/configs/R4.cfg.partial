hostname R4
!
interface Ethernet0/1
 ip ospf cost 5
 ip ospf 1 area 0
 no shutdown
!
interface Ethernet0/2
 ip ospf cost 3
 ip ospf 1 area 0
 no shutdown
!
interface Ethernet0/3
 ip ospf cost 5
 ip ospf 1 area 1
 no shutdown
!
interface Loopback0
 ip address 4.4.4.4 255.255.255.255
 ip ospf 1 area 0
!
router ospf 1
 router-id 4.4.4.4
