# LAB-014 baseline R2; OSPF authentication intentionally absent.
set interfaces eth1 unit 12 vlan-id 12
set interfaces eth1 unit 12 family inet address 10.0.12.2/30
set interfaces eth1 unit 24 vlan-id 24
set interfaces eth1 unit 24 family inet address 10.0.24.1/30
set interfaces lo0 unit 0 family inet address 10.1.1.2/32
set routing-options router-id 10.1.1.2
set protocols ospf area 0.0.0.0 interface eth1.12 interface-type p2p
set protocols ospf area 0.0.0.0 interface eth1.24 interface-type p2p
set protocols ospf area 0.0.0.0 interface lo0.0 passive
