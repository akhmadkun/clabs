# LAB-016 clean baseline. BFD stanza intentionally absent.
set interfaces eth1 unit 13 vlan-id 13
set interfaces eth1 unit 13 family inet address 10.0.13.2/30
set interfaces eth1 unit 34 vlan-id 34
set interfaces eth1 unit 34 family inet address 10.0.34.1/30
set interfaces lo0 unit 0 family inet address 10.1.1.3/32
set routing-options router-id 10.1.1.3
set protocols ospf area 0.0.0.0 interface eth1.13 interface-type p2p
set protocols ospf area 0.0.0.0 interface eth1.34 interface-type p2p
set protocols ospf area 0.0.0.0 interface lo0.0 passive
# Intentional incident: R3 requests a slower interval than the R1 target.
set protocols ospf area 0.0.0.0 interface eth1.13 bfd-liveness-detection minimum-interval 600
set protocols ospf area 0.0.0.0 interface eth1.13 bfd-liveness-detection multiplier 3
set protocols ospf area 0.0.0.0 interface eth1.13 bfd-liveness-detection full-neighbors-only
