name: ine-spv4-testing
prefix: ""
mgmt:
  network: fixedips
  ipv4-subnet: 10.200.255.0/24

topology:
  kinds:
    cisco_csr1000v:
      image: arthurk99/cisco-csr1000v:17.03.08
    ceos:
      image: ceos:4.35.0F
    cisco_xrd:
      image: sbezverk/xrd-control-plane:25.2.1
  nodes:
    R1:
      kind: cisco_csr1000v
      mgmt-ipv4: 10.200.255.2
      startup-config: ./lab_configs/csr_startup_config.cfg
      binds:
        - ./lab_configs/R1:/tftpboot/configs:ro
    R2:
      kind: cisco_csr1000v
      mgmt-ipv4: 10.200.255.3
      startup-config: ./lab_configs/csr_startup_config.cfg
      binds:
        - ./lab_configs/R2:/tftpboot/configs:ro

    XR1:
      kind: cisco_xrd
      mgmt-ipv4: 10.200.255.12
      #startup-delay: 500
      #startup-config: startup.cfg
      binds:
        - ./lab_configs/XR1:/misc/config/labconfigs:ro
    XR2:
      kind: cisco_xrd
      mgmt-ipv4: 10.200.255.13
      #startup-delay: 500
      #startup-config: startup.cfg
      binds:
        - ./lab_configs/XR2:/misc/config/labconfigs:ro


    SW:
      kind: ceos
      mgmt-ipv4: 10.200.255.18
      startup-config: lab_configs/SW.cfg


  links:
    - endpoints: ["R1:eth1","SW:eth1"]
    - endpoints: ["R2:eth2","SW:eth2"]
    - endpoints: ["XR1:Gi0-0-0-0","SW:eth11"]
    - endpoints: ["XR2:Gi0-0-0-0","SW:eth12"]

